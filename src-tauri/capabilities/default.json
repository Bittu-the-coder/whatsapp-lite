{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"remote": {
		"urls": [
			"https://web.whatsapp.com",
			"https://web.whatsapp.com/*"
		]
	},
	"permissions": [
		"core:default",
		"opener:default",
		"core:webview:allow-set-webview-zoom"
	]
}
